# ==============================================================================
# ELECTRATECH - DOCKER ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# Salin file ini menjadi .env di direktori root:
#   cp .env.example .env
#
# Sesuaikan nilai variabel di bawah ini dengan konfigurasi lingkungan Anda.
# ==============================================================================

# Port Mapping pada Host Mesin
BACKEND_PORT=4000
FRONTEND_PORT=3000
DB_PORT=5432
MQTT_PORT=1883

# Konfigurasi Database PostgreSQL
DB_USER=postgres
DB_PASSWORD=ganti_dengan_password_db_anda
DB_NAME=electratech
# Catatan: di docker compose, host db diarahkan ke service 'postgres'
DATABASE_URL=postgresql://postgres:ganti_dengan_password_db_anda@postgres:5432/electratech

# Konfigurasi Keamanan & CORS Backend
NODE_ENV=production
JWT_SECRET=buat_secret_token_jwt_yang_sangat_panjang_dan_aman_disini
CORS_ORIGIN=http://localhost:3000
BASE_URL=http://localhost:4000

# Akun Admin Default Backend
DEFAULT_ADMIN_NAME=Adminelectra
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=SandiRahasia123!
DEFAULT_ADMIN_STATUS=active

# Konfigurasi MQTT Broker
MQTT_ENABLED=true
# Gunakan 'mqtt://mosquitto:1883' untuk koneksi internal docker atau sesuaikan IP broker eksternal
MQTT_BROKER_URL=mqtt://mosquitto:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=electra_backend
MQTT_COMMAND_SUFFIX=/command

# Integrasi AI Gemini
GEMINI_API_KEY=

# Integrasi Smart Contract & Blockchain (Polygon/EVM)
BLOCKCHAIN_RPC_URL=https://polygon.drpc.org
BLOCKCHAIN_PRIVATE_KEY=
SMART_CONTRACT_ADDRESS=

# Konfigurasi Frontend Next.js
NEXT_PUBLIC_API_URL=http://localhost:4000
API_URL=http://backend:4000
